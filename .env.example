# Copy to .env.local and fill in. .env.local is gitignored.
# Running `vercel env pull .env.local` writes VERCEL_OIDC_TOKEN and any
# variables stored on the Vercel project; it overwrites the file, so add
# anything else after pulling.

# Required. Vercel Swag Store API deployment-protection bypass secret.
# Server-only: never prefix with NEXT_PUBLIC_.
BYPASS_SECRET=

# Required for /admin. Password for the store admin sign-in; choose your own.
# While unset, admin sign-in is disabled.
ADMIN_PASSWORD=

# Required locally for the agents. Authenticates AI Gateway and Vercel Sandbox.
# Written by `vercel env pull`; injected automatically on Vercel deployments.
VERCEL_OIDC_TOKEN=

# Optional. Alternative AI Gateway credential; takes precedence over OIDC for
# model calls. Sandbox still needs VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# Optional. Defaults to https://vercel-agentic-swag-store-api.vercel.app/api
API_BASE_URL=

# Optional. Public site URL for metadata. Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=
