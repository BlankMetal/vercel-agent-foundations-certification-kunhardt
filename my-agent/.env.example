# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Swag Store API base URL (no default in the eve agent).
API_BASE_URL=https://vercel-agentic-swag-store-api.vercel.app/api

# Required. Vercel Swag Store API deployment-protection bypass secret.
BYPASS_SECRET=

# Optional locally: `eve dev` connects a model credential in its terminal UI.
# Set it on the Vercel project when deploying the agent.
AI_GATEWAY_API_KEY=
